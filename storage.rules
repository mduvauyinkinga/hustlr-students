rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSeller() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    function isActiveSeller() {
      return isSeller() &&
        firestore.exists(/databases/(default)/documents/sellerSubscriptionPublic/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/sellerSubscriptionPublic/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function isAllowedImage() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp'
      ];
    }

    // Product uploads are owned by the seller recorded on the product document.
    match /products/{sellerId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveSeller() &&
        request.auth.uid == sellerId &&
        fileName.matches('^[^/]+\\.jpg$') &&
        firestore.exists(/databases/(default)/documents/products/$(fileName.split('.')[0])) &&
        firestore.exists(/databases/(default)/documents/productPrivate/$(fileName.split('.')[0])) &&
        firestore.get(/databases/(default)/documents/productPrivate/$(fileName.split('.')[0])).data.ownerId == request.auth.uid &&
        firestore.get(/databases/(default)/documents/products/$(fileName.split('.')[0])).data.storeId == request.auth.uid &&
        isAllowedImage() &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isActiveSeller() &&
        request.auth.uid == sellerId &&
        fileName.matches('^[^/]+\\.jpg$') &&
        firestore.exists(/databases/(default)/documents/products/$(fileName.split('.')[0])) &&
        firestore.exists(/databases/(default)/documents/productPrivate/$(fileName.split('.')[0])) &&
        firestore.get(/databases/(default)/documents/productPrivate/$(fileName.split('.')[0])).data.ownerId == request.auth.uid &&
        firestore.get(/databases/(default)/documents/products/$(fileName.split('.')[0])).data.storeId == request.auth.uid;
    }

    // Store media is owned by the seller whose UID is the store document ID.
    match /stores/{sellerId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveSeller() &&
        request.auth.uid == sellerId &&
        fileName in ['logo.jpg', 'banner.jpg'] &&
        firestore.exists(/databases/(default)/documents/stores/$(sellerId)) &&
        isAllowedImage() &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isActiveSeller() &&
        request.auth.uid == sellerId &&
        fileName in ['logo.jpg', 'banner.jpg'] &&
        firestore.exists(/databases/(default)/documents/stores/$(sellerId)) &&
        firestore.get(/databases/(default)/documents/stores/$(sellerId)).data.status == 'active';
    }

    // Deny every unrecognized path, including path traversal or arbitrary uploads.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
